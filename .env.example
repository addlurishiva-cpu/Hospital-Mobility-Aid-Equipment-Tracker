# Hospital Mobility Aid and Reusable Equipment Tracker - Environment Configuration Example
# Copy this file to .env and configure your actual Supabase credentials.

# Server Configuration
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# Supabase PostgreSQL Configuration
# When SUPABASE_URL and SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY are provided,
# the backend reads and writes directly to Supabase cloud PostgreSQL.
# If credentials are not provided or unreachable, the system automatically falls
# back to a fully deterministic in-memory / state-persisted PostgreSQL emulator
# preloaded with complete synthetic seed data, allowing immediate offline evaluation.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-placeholder
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key-placeholder
DATABASE_URL=postgresql://postgres.[project-id]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
